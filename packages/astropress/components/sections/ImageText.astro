---
import type { ImageTextSection } from "../../src/sections/schema";

interface Props {
	section: ImageTextSection;
	mediaUrls: Record<string, string>;
}
const { section, mediaUrls } = Astro.props;
const mediaUrl = mediaUrls[section.mediaId] ?? null;
const side = section.imageSide === "end" ? "end" : "start";
---
<section class="ap-section ap-image-text" data-image-side={side}>
  <div class="ap-image-text__media">
    {mediaUrl ? (
      <img src={mediaUrl} alt="" loading="lazy" decoding="async" />
    ) : (
      <div class="ap-image-text__placeholder" aria-hidden="true"></div>
    )}
  </div>
  <div class="ap-image-text__copy">
    <h2 class="ap-image-text__heading">{section.heading}</h2>
    <div class="ap-image-text__body" set:html={section.body}></div>
  </div>
</section>
