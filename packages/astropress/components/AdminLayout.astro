---
import { buildAstropressAdminDocumentTitle } from "../src/admin-branding";
import { resolveAdminLocale } from "../src/admin-locale";
import { getPageT } from "../src/admin-page-labels";
import { getRecentAdminItems } from "../src/admin-recent";
import { resolveAstropressAdminUiConfig } from "../src/admin-ui";
import { peekCmsConfig } from "../src/config";
import { getAdminBootstrapConfig } from "../src/runtime-env";
import { applyAstropressSecurityHeaders } from "../src/security-headers";

interface NavItem {
	href?: string;
	label: string;
	adminOnly?: boolean;
	isGroupLabel?: boolean;
	indent?: boolean;
}

interface Props {
	title: string;
	heading: string;
	currentPath: string;
	description?: string;
	role: "admin" | "editor";
	userName: string;
	siteName?: string;
	/** When true, shows the CMS nav item linking to /ap-admin/cms. */
	hasCms?: boolean;
	/** When true, shows the Host nav item (admin-only) linking to /ap-admin/host. */
	hasHostPanel?: boolean;
	/** When true, shows the Publish button in the topbar (admin-only). */
	canPublish?: boolean;
}

const {
	title,
	heading,
	currentPath,
	description = "",
	role,
	userName,
	siteName,
	hasCms = false,
	hasHostPanel = false,
	canPublish = false,
} = Astro.props;
const documentTitle = buildAstropressAdminDocumentTitle(title);
const adminLocale = resolveAdminLocale(Astro);
const adminUi = resolveAstropressAdminUiConfig(adminLocale);
const tLayout = getPageT(adminLocale);
const adminSiteName = siteName ?? adminUi.branding.shellName;
const { bootstrapDisabled } = getAdminBootstrapConfig(Astro.locals);
applyAstropressSecurityHeaders(Astro.response.headers, {
	area: "admin",
	allowInlineStyles: import.meta.env.DEV,
	forceHsts: Astro.url.protocol === "https:",
});
const recentItems = await getRecentAdminItems(Astro.locals, role);

const pluginNavItems: NavItem[] = (peekCmsConfig()?.plugins ?? [])
	.flatMap((p) => p.navItems ?? [])
	.map((item) => ({ href: item.href, label: item.label, indent: true }));

// Information architecture: every leaf is always rendered. Pages whose
// backing integration is absent show <RequiresIntegration> as their body, so
// nav advertises the platform's full capability surface even on minimal
// installs. Group order: Site → Content → Audience → Discoverability →
// Integrations → Access → Operations.
const groupSep = (label: string): NavItem => ({
	href: "",
	label,
	isGroupLabel: true,
});
const leaf = (
	href: string,
	label: string,
	opts: { adminOnly?: boolean } = {},
): NavItem => ({ href, label, indent: true, adminOnly: opts.adminOnly });

const navItems: NavItem[] = [
	{ href: "/ap-admin", label: adminUi.navigation.dashboard },

	groupSep(adminUi.navigation.groupSite),
	leaf("/ap-admin/pages", adminUi.navigation.pages, { adminOnly: true }),
	leaf("/ap-admin/route-pages", adminUi.navigation.routePages, {
		adminOnly: true,
	}),
	leaf("/ap-admin/archives", adminUi.navigation.archives, { adminOnly: true }),
	leaf("/ap-admin/media", adminUi.navigation.media),
	leaf("/ap-admin/redirects", adminUi.navigation.redirects, {
		adminOnly: true,
	}),
	leaf("/ap-admin/forms", adminUi.navigation.forms),

	groupSep(adminUi.navigation.contentGroup),
	leaf("/ap-admin/posts", adminUi.navigation.posts),
	leaf("/ap-admin/authors", adminUi.navigation.authors, { adminOnly: true }),
	leaf("/ap-admin/taxonomies", adminUi.navigation.taxonomies, {
		adminOnly: true,
	}),
	leaf("/ap-admin/cms", adminUi.navigation.headlessCmsPanel),

	groupSep(adminUi.navigation.groupAudience),
	leaf("/ap-admin/subscribers", adminUi.navigation.subscribers, {
		adminOnly: true,
	}),
	leaf("/ap-admin/newsletter", adminUi.navigation.newsletter, {
		adminOnly: true,
	}),
	leaf("/ap-admin/comments", adminUi.navigation.comments),
	leaf("/ap-admin/events", adminUi.navigation.events, { adminOnly: true }),
	leaf("/ap-admin/testimonials", adminUi.navigation.testimonials, {
		adminOnly: true,
	}),
	leaf("/ap-admin/reviews", adminUi.navigation.reviews, { adminOnly: true }),
	leaf("/ap-admin/referrals", adminUi.navigation.referrals, {
		adminOnly: true,
	}),
	leaf("/ap-admin/memberships", adminUi.navigation.memberships, {
		adminOnly: true,
	}),
	leaf("/ap-admin/fundraising", adminUi.navigation.fundraising, {
		adminOnly: true,
	}),
	leaf("/ap-admin/community", adminUi.navigation.community, {
		adminOnly: true,
	}),
	leaf("/ap-admin/shop", adminUi.navigation.shop, { adminOnly: true }),
	leaf("/ap-admin/social-syndication", adminUi.navigation.socialSyndication, {
		adminOnly: true,
	}),

	groupSep(adminUi.navigation.groupDiscoverability),
	leaf("/ap-admin/seo", adminUi.navigation.seo, { adminOnly: true }),
	leaf("/ap-admin/structured-data", adminUi.navigation.structuredData, {
		adminOnly: true,
	}),
	leaf("/ap-admin/sitemaps", adminUi.navigation.sitemaps, { adminOnly: true }),
	leaf("/ap-admin/maps-local", adminUi.navigation.mapsLocal, {
		adminOnly: true,
	}),
	leaf("/ap-admin/translations", adminUi.navigation.translations, {
		adminOnly: true,
	}),

	groupSep(adminUi.navigation.groupIntegrations),
	leaf("/ap-admin/services", adminUi.navigation.services, { adminOnly: true }),
	leaf("/ap-admin/analytics", adminUi.navigation.analytics, {
		adminOnly: true,
	}),
	leaf("/ap-admin/heatmaps", adminUi.navigation.heatmaps, { adminOnly: true }),
	leaf("/ap-admin/ab-testing", adminUi.navigation.abTesting, {
		adminOnly: true,
	}),
	leaf("/ap-admin/email", adminUi.navigation.email, { adminOnly: true }),
	leaf("/ap-admin/live-chat", adminUi.navigation.liveChat, {
		adminOnly: true,
	}),
	leaf("/ap-admin/image-cdn", adminUi.navigation.imageCdn, {
		adminOnly: true,
	}),
	leaf("/ap-admin/search", adminUi.navigation.search, { adminOnly: true }),
	leaf("/ap-admin/cdn-purge", adminUi.navigation.cdnPurge, {
		adminOnly: true,
	}),
	leaf("/ap-admin/monitoring", adminUi.navigation.monitoring, {
		adminOnly: true,
	}),
	leaf("/ap-admin/api-tokens", adminUi.navigation.apiTokens, {
		adminOnly: true,
	}),
	leaf("/ap-admin/webhooks", adminUi.navigation.webhooks, { adminOnly: true }),
	leaf("/ap-admin/deploy-hooks", adminUi.navigation.deployHooks, {
		adminOnly: true,
	}),
	leaf("/ap-admin/plugins", adminUi.navigation.plugins, { adminOnly: true }),
	...pluginNavItems,

	groupSep(adminUi.navigation.groupAccess),
	leaf("/ap-admin/users", adminUi.navigation.users, { adminOnly: true }),

	groupSep(adminUi.navigation.groupOperations),
	leaf("/ap-admin/system", adminUi.navigation.system, { adminOnly: true }),
	...(hasHostPanel
		? [leaf("/ap-admin/host", adminUi.navigation.host, { adminOnly: true })]
		: []),
	leaf("/ap-admin/data", adminUi.navigation.data, { adminOnly: true }),
	leaf("/ap-admin/settings", adminUi.navigation.settings, { adminOnly: true }),
	leaf("/ap-admin/backups", adminUi.navigation.backups, { adminOnly: true }),
];

// hasCms is kept on Props for backwards compatibility but no longer gates
// nav — every leaf renders unconditionally and individual pages show
// <RequiresIntegration> when their backing config is missing.
void hasCms;

// Derive the heading + document title from the matched nav item so SSR
// localisation flows through to every admin page without each page having
// to translate its own "Pages" / "Posts" / "Settings" prop. Pages that don't
// map to a nav entry (Forbidden, 404, etc.) keep the prop value.
const matchedNavItem = navItems.find(
	(item) => item.href && item.href === currentPath && !item.isGroupLabel,
);
const localisedHeading = matchedNavItem?.label ?? heading;
const localisedTitle = matchedNavItem?.label ?? title;
const documentTitleResolved = matchedNavItem
	? buildAstropressAdminDocumentTitle(localisedTitle)
	: documentTitle;
---

<!doctype html>
<html lang={adminLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    {adminUi.branding.faviconHref && <link rel="icon" href={adminUi.branding.faviconHref} />}
    <link rel="stylesheet" href="/admin.css" />
    {adminUi.branding.stylesheetHref && <link rel="stylesheet" href={adminUi.branding.stylesheetHref} />}
    <title>{documentTitleResolved}</title>
    <meta name="description" content={description || documentTitle} />
  </head>
  <body>
    <a class="skip-link" href="#admin-main">{tLayout("layout.skipToContent")}</a>
    <header class="topbar">
      <a class="topbar-brand" href={adminUi.branding.logoHref}>
        {adminUi.branding.logoSrc ? (
          <img src={adminUi.branding.logoSrc} alt={adminUi.branding.logoAlt} class="topbar-logo" />
        ) : null}
        <strong>{adminSiteName}</strong>
      </a>
      <div class="topbar-meta">
        {canPublish && role === "admin" && (
          <form method="post" action="/ap-admin/actions/publish" class="publish-form">
            <button type="submit" class="publish-btn" title="Trigger a new production build">
              Publish
            </button>
          </form>
        )}
        <button
          type="button"
          class="nav-toggle"
          data-nav-toggle
          aria-label={tLayout("layout.openNavigation")}
          aria-expanded="false"
          aria-controls="admin-sidebar"
          data-label-open="Open navigation"
          data-label-close="Close navigation"
        >
          <span aria-hidden="true">☰</span>
        </button>
        <span>{adminUi.labels.signedInAsPrefix} {userName}</span>
        <span class="role-chip">{role}</span>
        <details class="topbar-panel-details" id="topbar-utility-details">
          <summary class="topbar-panel-toggle" aria-label={tLayout("layout.toggleUtilityPanel")}>
            <span class="panel-toggle-arrows" aria-hidden="true">
              <svg class="panel-toggle-arrow panel-toggle-arrow-closed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
              <svg class="panel-toggle-arrow panel-toggle-arrow-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </span>
          </summary>
          <div id="topbar-utility-panel" class="topbar-utility-panel">
          <ap-theme-toggle label-dark={adminUi.labels.themeToggleDark} label-light={adminUi.labels.themeToggleLight}>
            <button
              type="button"
              class="topbar-utility-btn"
              aria-pressed="false"
              aria-label={adminUi.labels.themeToggleDark}
              title={adminUi.labels.themeToggleDark}
            >
              <span class="theme-toggle-icon" aria-hidden="true"></span>
            </button>
          </ap-theme-toggle>
          <select
            class="topbar-utility-btn locale-select"
            aria-label={adminUi.labels.changeLanguage}
            title={adminUi.labels.changeLanguage}
            data-locale-select
          >
            <option value="en" selected={adminLocale === "en"}>EN</option>
            <option value="es" selected={adminLocale === "es"}>ES</option>
            <option value="fr" selected={adminLocale === "fr"}>FR</option>
            <option value="de" selected={adminLocale === "de"}>DE</option>
            <option value="pt" selected={adminLocale === "pt"}>PT</option>
            <option value="ja" selected={adminLocale === "ja"}>JA</option>
            <option value="te" selected={adminLocale === "te"}>TE</option>
            <option value="hi" selected={adminLocale === "hi"}>HI</option>
            <option value="ny" selected={adminLocale === "ny"}>NY</option>
          </select>
          <button
            type="button"
            class="topbar-utility-btn"
            popovertarget="admin-keyboard-shortcuts"
            aria-label={tLayout("layout.keyboardShortcuts")}
            title={tLayout("layout.keyboardShortcuts")}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect><path d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01M8 12h.01M12 12h.01M16 12h.01M8 16h8"></path></svg>
          </button>
          <button
            type="button"
            class="topbar-utility-btn"
            id="scroll-to-bottom-btn"
            aria-label={tLayout("layout.scrollToBottom")}
            title={tLayout("layout.scrollToBottom")}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
        </div>
        </details>
        <div
          id="admin-keyboard-shortcuts"
          popover
          class="keyboard-shortcuts-popover"
          role="dialog"
          aria-label={tLayout("layout.keyboardShortcuts")}
        >
          <h2>{tLayout("layout.keyboardShortcuts")}</h2>
          <table>
            <tbody>
              <tr><td><kbd>Ctrl</kbd>+<kbd>S</kbd></td><td>{tLayout("layout.shortcutSaveDraft")}</td></tr>
              <tr><td><kbd>Ctrl</kbd>+<kbd>Enter</kbd></td><td>{tLayout("layout.shortcutPublish")}</td></tr>
              <tr><td><kbd>Escape</kbd></td><td>{tLayout("layout.shortcutEscape")}</td></tr>
              <tr><td><kbd>Tab</kbd></td><td>{tLayout("layout.shortcutTab")}</td></tr>
              <tr><td><kbd>Shift</kbd>+<kbd>Tab</kbd></td><td>{tLayout("layout.shortcutShiftTab")}</td></tr>
              <tr><td><kbd>?</kbd></td><td>{tLayout("layout.shortcutHelp")}</td></tr>
              <tr><td><kbd>Ctrl</kbd>+<kbd>K</kbd></td><td>{tLayout("layout.shortcutCmd")}</td></tr>
            </tbody>
          </table>
        </div>
        <form method="post" action="/ap-admin/session?logout=1">
          <button type="submit">{adminUi.labels.signOut}</button>
        </form>
        <script>
          (function () {
            // Locale: persist choice in a cookie and reload so SSR re-renders labels.
            var sel = document.querySelector('[data-locale-select]');
            if (sel) {
              sel.addEventListener('change', function () {
                document.cookie = 'astropress_admin_locale=' + encodeURIComponent(sel.value) + '; path=/; max-age=31536000; samesite=Lax';
                window.location.reload();
              });
            }

            // Utility panel: close on click-outside and Escape (details element has no native light-dismiss).
            var details = document.getElementById('topbar-utility-details');
            if (details) {
              document.addEventListener('click', function (e) {
                if (details.open && !details.contains(e.target)) details.removeAttribute('open');
              });
              document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && details.open) { details.removeAttribute('open'); e.stopPropagation(); }
              });
            }

            // Down-arrow in the utility bar: scroll the page to the bottom.
            var scrollDownBtn = document.getElementById('scroll-to-bottom-btn');
            if (scrollDownBtn) {
              scrollDownBtn.addEventListener('click', function () {
                window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
              });
            }

            // Scroll-to-top FAB: shown only after the topbar has scrolled
            // fully out of view. Uses IntersectionObserver against the
            // <header class="topbar"> element so the trigger tracks the
            // actual chrome rather than a magic-number scroll offset.
            var fab = document.getElementById('scroll-to-top-fab');
            var topbar = document.querySelector('header.topbar');
            if (fab && topbar) {
              var visible = false;
              function setVisibility(shouldShow) {
                if (shouldShow === visible) return;
                visible = shouldShow;
                if (shouldShow) {
                  fab.hidden = false;
                  requestAnimationFrame(function () { fab.classList.add('is-visible'); });
                } else {
                  fab.classList.remove('is-visible');
                  setTimeout(function () { if (!visible) fab.hidden = true; }, 220);
                }
              }
              var io = new IntersectionObserver(function (entries) {
                // The topbar is "not visible" when none of it intersects the viewport.
                setVisibility(!entries[0].isIntersecting);
              }, { threshold: 0 });
              io.observe(topbar);
              fab.addEventListener('click', function () {
                window.scrollTo({ top: 0, behavior: 'smooth' });
              });
            }
          })();
        </script>
      </div>
    </header>
    <ap-admin-nav>
    <div class="admin-shell">
      <nav id="admin-sidebar" class="sidebar" data-nav-sidebar aria-label={tLayout("layout.adminSections")}>
        <button
          type="button"
          class="nav-close"
          data-nav-close
          aria-label={tLayout("layout.closeNavigation")}
        >
          <span aria-hidden="true">✕</span>
        </button>
        <p class="sidebar-label">{adminUi.labels.sidebarTitle}</p>
        {navItems
          .filter((item) => (item.adminOnly ? role === "admin" : true))
          .map((item) => {
            if (item.isGroupLabel) {
              return <p class="sidebar-group-label">{item.label}</p>;
            }
            return (
              <a
                href={item.href}
                aria-current={currentPath === item.href ? "page" : undefined}
                class={item.indent ? "sidebar-child" : ""}
              >
                {item.label}
              </a>
            );
          })}
        {recentItems.length > 0 && (
          <>
            <p class="sidebar-group-label">{tLayout("layout.recent")}</p>
            {recentItems.map((item) => (
              <a
                href={item.editHref}
                class="sidebar-child sidebar-recent-item"
                title={item.title}
              >
                {item.title.length > 28 ? item.title.slice(0, 26) + "\u2026" : item.title}
              </a>
            ))}
          </>
        )}
      </nav>
      <main id="admin-main" tabindex="-1">
        <section class="page-header">
          <h1>{localisedHeading}</h1>
          {description && <p>{description}</p>}
        </section>
        {!bootstrapDisabled && (
          <ap-notice type="warning">
            {tLayout("banner.bootstrap.before")} <a href="/ap-admin/settings">{tLayout("banner.bootstrap.link")}</a> {tLayout("banner.bootstrap.after")}
          </ap-notice>
        )}
        <div
          role="alert"
          aria-live="assertive"
          aria-atomic="true"
          data-action-error
          class="action-error-region"
        ></div>
        <slot />
      </main>
    </div>
    </ap-admin-nav>
    <footer class="ap-admin-footer">
      <a
        href="https://github.com/Astropress/astropress/issues"
        target="_blank"
        rel="noopener noreferrer"
        class="ap-admin-footer__link"
      >{tLayout("footer.reportIssue")}</a>
      <span class="ap-admin-footer__sep" aria-hidden="true">·</span>
      <a
        href="https://github.com/Astropress/astropress"
        target="_blank"
        rel="noopener noreferrer"
        class="ap-admin-footer__link"
      >Astropress</a>
    </footer>
    <button
      type="button"
      id="scroll-to-top-fab"
      class="scroll-to-top-fab"
      aria-label={tLayout("layout.scrollToTop")}
      title={tLayout("layout.scrollToTop")}
      hidden
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="18 15 12 9 6 15"></polyline></svg>
    </button>
    <ap-command-palette data-nav-items={JSON.stringify(navItems.filter((n) => n.href && !n.isGroupLabel).map((n) => ({ label: n.label, href: n.href })))}>
      <dialog id="cmd-palette" class="cmd-palette" aria-label={tLayout("layout.commandPalette")}>
        <input type="search" class="cmd-input" placeholder={tLayout("layout.goTo")} aria-label={tLayout("layout.searchAdminPages")} autocomplete="off" />
        <ul class="cmd-results" role="listbox" aria-label={tLayout("layout.commandPaletteResults")} aria-live="polite"></ul>
      </dialog>
    </ap-command-palette>
    <script>
      import "../web-components/theme-toggle";
      import "../web-components/admin-nav";
      import "../web-components/notice";
      import "../web-components/command-palette";
      import "../web-components/pending-form";
    </script>
    <script>
      // Progressive enhancement: inline form validation with custom messages.
      // Degrades gracefully when JS is unavailable — browser native validation still applies.
      (function () {
        function getCustomMessage(input: HTMLInputElement): string {
          if (!input.validity.valid) {
            if (input.dataset.errorRequired && input.validity.valueMissing) return input.dataset.errorRequired;
            if (input.dataset.errorPattern && input.validity.patternMismatch) return input.dataset.errorPattern;
            if (input.dataset.errorMinlength && input.validity.tooShort) return input.dataset.errorMinlength;
            if (input.dataset.errorType && (input.validity.typeMismatch || input.validity.badInput)) return input.dataset.errorType;
          }
          return input.validationMessage;
        }

        function showError(input: HTMLInputElement): void {
          const describedBy = input.getAttribute("aria-describedby");
          let errorEl = describedBy ? document.getElementById(describedBy) : null;
          if (!errorEl) {
            const id = `field-error-${Math.random().toString(36).slice(2)}`;
            errorEl = document.createElement("span");
            errorEl.id = id;
            errorEl.className = "field-error";
            errorEl.setAttribute("aria-live", "polite");
            input.insertAdjacentElement("afterend", errorEl);
            input.setAttribute("aria-describedby", id);
          }
          const msg = getCustomMessage(input);
          errorEl.textContent = msg;
          input.setAttribute("aria-invalid", msg ? "true" : "false");
        }

        function clearError(input: HTMLInputElement): void {
          input.setCustomValidity("");
          const id = input.getAttribute("aria-describedby");
          const errorEl = id ? document.getElementById(id) : null;
          if (errorEl) errorEl.textContent = "";
          input.setAttribute("aria-invalid", "false");
        }

        document.addEventListener("invalid", (e) => {
          const input = e.target as HTMLInputElement;
          if (!(input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement || input instanceof HTMLSelectElement)) return;
          e.preventDefault();
          showError(input as HTMLInputElement);
        }, true);

        document.addEventListener("input", (e) => {
          const input = e.target as HTMLInputElement;
          if (!(input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement)) return;
          if (input.getAttribute("aria-invalid") === "true") clearError(input as HTMLInputElement);
        });

        // Restore session-storage error messages (set by server actions to keep sensitive names out of URL history).
        const storedError = sessionStorage.getItem("ap_action_error");
        if (storedError) {
          sessionStorage.removeItem("ap_action_error");
          const liveRegion = document.querySelector<HTMLElement>("[aria-live='assertive'][data-action-error]");
          if (liveRegion) liveRegion.textContent = storedError;
        }

        // Optimistic publish button — disable and relabel on submit; page navigation completes naturally.
        document.querySelector(".publish-form")?.addEventListener("submit", (e) => {
          const btn = (e.currentTarget as HTMLFormElement).querySelector<HTMLButtonElement>(".publish-btn");
          if (btn) { btn.textContent = "Publishing\u2026"; btn.disabled = true; }
        });

        // Generic form submit loading state — disable button and append ellipsis to prevent double submission.
        document.querySelectorAll<HTMLFormElement>("form:not(.publish-form)").forEach((form) => {
          form.addEventListener("submit", () => {
            const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
            if (!btn || btn.disabled) return;
            btn.disabled = true;
            const original = btn.textContent?.trim() ?? "";
            btn.textContent = original + "\u2026";
            setTimeout(() => { btn.disabled = false; btn.textContent = original; }, 8000);
          });
        });
      })();
    </script>
  <style>
    .ap-admin-footer {
      padding: 0.5rem 1.5rem;
      font-size: 0.75rem;
      color: var(--muted);
      border-top: 1px solid var(--line);
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }
    .ap-admin-footer__link {
      color: var(--text);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      padding: 0 0.5rem;
    }
    .ap-admin-footer__link:hover {
      text-decoration: underline;
    }
    .ap-admin-footer__sep {
      color: var(--muted);
    }
  </style>
  </body>
</html>
