{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@astropress-diy/astropress": ["./index.ts"],
			"@astropress-diy/astropress/components/*": ["./components/*"],
			"@astropress-diy/astropress/*": ["./src/*"],
			"astropress": ["./index.ts"],
			"astropress/components/*": ["./components/*"],
			"astropress/*": ["./src/*"]
		},
		"ignoreDeprecations": "6.0"
	},
	"include": ["src/**/*", "index.ts", "components/**/*", "bin/**/*", "env.d.ts", "pages/**/*"]
}
