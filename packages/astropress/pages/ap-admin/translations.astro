---
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import CsrfInput from "@astropress-diy/astropress/components/CsrfInput.astro";
import {
	buildTranslationsPageModel,
	getPageT,
	resolveAdminLocale,
	translationStates,
} from "astropress";

const adminUser = Astro.locals.adminUser;
const model = await buildTranslationsPageModel(Astro.locals, adminUser?.role);
if (model.status === "forbidden") {
	Astro.response.status = 403;
}

const wasSaved = Astro.url.searchParams.get("saved") === "1";
const validStates = [...translationStates];
const selectedState = Astro.url.searchParams.get("state") ?? "all";
const rows = model.data.rows;
const filteredRows = rows.filter(
	(entry) => selectedState === "all" || entry.effectiveState === selectedState,
);
const stateCounts = rows.reduce<Record<string, number>>(
	(accumulator, entry) => {
		accumulator[entry.effectiveState] =
			(accumulator[entry.effectiveState] ?? 0) + 1;
		return accumulator;
	},
	{},
);
const t = getPageT(resolveAdminLocale(Astro));
---

{model.status !== "forbidden" ? (
  <AdminLayout
    title={t("translations.title")}
    heading={t("translations.title")}
    currentPath="/ap-admin/translations"
    description={t("translations.description")}
    role={adminUser!.role}
    userName={adminUser!.name}
  >
    {model.warnings.length > 0 && <p class="notice">{t("translations.partialResults")}</p>}
    {wasSaved && <p class="notice">{t("translations.savedSuccess")}</p>}
    <div class="admin-subgrid two summary-grid">
      <section class="panel stat summary-card">
        <span>{t("translations.localizedRoutes")}</span>
        <strong>{rows.length}</strong>
        <span>{t("translations.localizedRoutesDesc")}</span>
      </section>
      <section class="panel stat summary-card">
        <span>{t("translations.publishedTranslations")}</span>
        <strong>{stateCounts.published ?? 0}</strong>
        <span>{t("translations.publishedTranslationsDesc")}</span>
      </section>
    </div>
    <section class="panel translations-panel">
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("translations.coverageKicker")}</p>
          <h2>{t("translations.coverageHeading")}</h2>
          <p>{t("translations.coverageDesc")}</p>
        </div>
        <form method="get" class="translation-filter">
          <label>
            <span class="sr-only">{t("translations.filterAria")}</span>
            <select class="admin-select" name="state" aria-label={t("translations.filterAria")}>
              <option value="all" selected={selectedState === "all"}>{t("translations.allStates")}</option>
              {validStates.map((state) => (
                <option value={state} selected={selectedState === state}>
                  {state}
                </option>
              ))}
            </select>
          </label>
          <button type="submit" class="admin-button">{t("translations.applyFilter")}</button>
        </form>
      </div>
      <p><strong>{filteredRows.length} {t("translations.summaryOf")} {rows.length} {t("translations.summaryRoutes")}</strong></p>
      <div class="admin-table-shell">
        <table aria-label={t("translations.tableAria")}>
          <thead>
            <tr>
              <th>{t("translations.route")}</th>
              <th>{t("translations.locale")}</th>
              <th>{t("translations.englishSource")}</th>
              <th>{t("common.status")}</th>
              <th>{t("translations.edit")}</th>
              <th>{t("translations.update")}</th>
            </tr>
          </thead>
          <tbody>
            {filteredRows.map((entry) => {
              const effectiveState = entry.effectiveState;
              return (
                <tr>
                  <td><code>{entry.route}</code></td>
                  <td>{entry.locale}</td>
                  <td><code>{entry.englishSourceUrl}</code></td>
                  <td><span class="admin-chip">{effectiveState}</span></td>
                  <td class="edit-links">
                    {entry.englishEditHref && <a href={entry.englishEditHref} class="admin-button-ghost small">{t("translations.editEn")}</a>}
                    {entry.localizedEditHref && <a href={entry.localizedEditHref} class="admin-button-ghost small">{t("translations.editLocale")}</a>}
                  </td>
                  <td>
                    <form method="post" action="/ap-admin/actions/translation-update" class="translation-update">
                      <CsrfInput token={Astro.locals.csrfToken} />
                      <input type="hidden" name="route" value={entry.route} />
                      <select class="admin-select" name="state" required aria-label={`${t("translations.translationStateForRoute")} ${entry.route}`}>
                        {validStates.map((state) => (
                          <option value={state} selected={effectiveState === state}>
                            {state}
                          </option>
                        ))}
                      </select>
                      <button type="submit" class="admin-button-ghost small">{t("translations.saveState")}</button>
                    </form>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  </AdminLayout>
) : (
  <AdminLayout
    title={t("translations.forbiddenTitle")}
    heading={t("translations.forbiddenTitle")}
    currentPath="/ap-admin/posts"
    description={t("translations.forbiddenDesc")}
    role={adminUser!.role}
    userName={adminUser!.name}
  >
    <section class="panel">
      <p>{t("translations.forbiddenBody")}</p>
    </section>
  </AdminLayout>
)}

<style>
  .summary-grid {
    margin-bottom: 1rem;
  }

  .summary-card span:first-child {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-weight: 700;
  }

  .summary-card span:last-child {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .translations-panel {
    display: grid;
    gap: 1rem;
  }

  .translation-filter {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .translation-update {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .translation-filter select,
  .translation-update select {
    min-width: 9rem;
  }

  .translation-filter button,
  .translation-update button {
    padding: 0;
  }

  .edit-links {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>
