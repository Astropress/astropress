---
import { safeAdminUserName } from "astropress";
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import AuditTrail from "@astropress-diy/astropress/components/AuditTrail.astro";
import CsrfInput from "@astropress-diy/astropress/components/CsrfInput.astro";
import { buildTaxonomiesPageModel, getPageT, resolveAdminLocale } from "astropress";

const adminUser = Astro.locals.adminUser;
const model = await buildTaxonomiesPageModel(Astro.locals, adminUser);
const { categories, tags, auditEvents } = model.data;
const wasSaved = Astro.url.searchParams.get("saved") === "1";
const wasDeleted = Astro.url.searchParams.get("deleted") === "1";
const restoreTable = Astro.url.searchParams.get("restore_table") ?? "";
const restoreId = Astro.url.searchParams.get("restore_id") ?? "";
const errorMessage =
	Astro.url.searchParams.get("error") === "1" ? Astro.url.searchParams.get("message") : "";
const t = getPageT(resolveAdminLocale(Astro));

if (model.status === "forbidden") {
	Astro.response.status = 403;
}
---

{model.status !== "forbidden" ? (
  <AdminLayout
    title={t("taxonomies.title")}
    heading={t("taxonomies.title")}
    currentPath="/ap-admin/taxonomies"
    description={t("taxonomies.description")}
    userName={safeAdminUserName(adminUser)}
  >
    {model.warnings.length > 0 && <p class="notice">{t("taxonomies.partialResults")}</p>}
    {wasSaved && <p class="notice">{t("taxonomies.savedSuccess")}</p>}
    {wasDeleted && restoreId && (
      <div class="undo-toast" role="status" aria-live="polite" data-undo-toast>
        {t("taxonomies.deletedToast")}
        <form method="post" action="/ap-admin/actions/restore" style="display:contents">
          <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
          <input type="hidden" name="table" value={restoreTable} />
          <input type="hidden" name="id" value={restoreId} />
          <input type="hidden" name="return_to" value="/ap-admin/taxonomies" />
          <button type="submit" class="undo-btn">{t("taxonomies.undo")}</button>
        </form>
      </div>
    )}
    {wasDeleted && !restoreId && <p class="notice">{t("taxonomies.deletedSuccess")}</p>}
    {errorMessage && <p class="error-notice">{errorMessage}</p>}

    <div class="taxonomy-grid">
      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("taxonomies.categories")}</h2>
            <p>{t("taxonomies.categoriesDesc")}</p>
          </div>
        </div>
        <form class="stack-form" method="post" action="/ap-admin/actions/taxonomy-save">
          <CsrfInput token={Astro.locals.csrfToken} />
          <input type="hidden" name="kind" value="category" />
          <label class="admin-field">
            <span>{t("taxonomies.categoryName")}</span>
            <input aria-label={t("taxonomies.categoryName")} type="text" name="name" placeholder="Programs" class="admin-input" />
          </label>
          <label class="admin-field">
            <span>{t("taxonomies.slug")}</span>
            <input aria-label={t("taxonomies.categorySlug")} type="text" name="slug" placeholder="programs" class="admin-input" />
          </label>
          <label class="admin-field">
            <span>{t("taxonomies.descriptionField")}</span>
            <textarea aria-label={t("taxonomies.categoryDescription")} name="description" rows="2" class="admin-textarea"></textarea>
          </label>
          <button type="submit" class="admin-button">{t("taxonomies.saveCategory")}</button>
        </form>
        <table aria-label={t("taxonomies.categories")}>
          <thead>
            <tr>
              <th>{t("taxonomies.thName")}</th>
              <th>{t("taxonomies.thSlug")}</th>
              <th>{t("common.actions")}</th>
            </tr>
          </thead>
          <tbody>
            {categories.map((term) => (
              <tr>
                <td>{term.name}</td>
                <td>{term.slug}</td>
                <td class="actions">
                  <details>
                    <summary class="edit-summary">{t("taxonomies.edit")}</summary>
                    <form method="post" action="/ap-admin/actions/taxonomy-save" class="inline-form">
                      <CsrfInput token={Astro.locals.csrfToken} />
                      <input type="hidden" name="kind" value="category" />
                      <input type="hidden" name="id" value={term.id} />
                      <input aria-label={`${t("taxonomies.categoryName")} ${term.slug}`} type="text" name="name" value={term.name} class="admin-input" />
                      <input aria-label={`${t("taxonomies.categorySlug")} ${term.slug}`} type="text" name="slug" value={term.slug} class="admin-input" />
                      <textarea aria-label={`${t("taxonomies.categoryDescription")} ${term.slug}`} name="description" rows="2" class="admin-textarea">{term.description || ""}</textarea>
                      <button type="submit" class="admin-button small">{t("taxonomies.update")}</button>
                    </form>
                  </details>
                  <button
                    type="button"
                    class="admin-button-ghost small delete-button"
                    data-confirm-trigger
                    data-dialog-id="confirm-delete-category"
                    data-field-name="id"
                    data-field-value={term.id}
                    data-text-category-name={term.name}
                  >
                    {t("taxonomies.delete")}
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <ap-confirm-dialog>
          <dialog id="confirm-delete-category" class="confirm-modal" aria-labelledby="confirm-delete-category-title">
            <div class="modal-content">
              <h2 id="confirm-delete-category-title">{t("taxonomies.deleteCategoryDialogTitle")}</h2>
              <p>{t("taxonomies.deleteConfirmPrefix")}<strong id="category-name"></strong>{t("taxonomies.deleteConfirmSuffix")}</p>
              <p class="dialog-warning">{t("taxonomies.deleteWarning")}</p>
              <div class="modal-actions">
                <button type="button" class="admin-button-ghost small secondary-button" data-dialog-close>{t("taxonomies.cancel")}</button>
                <form method="post" action="/ap-admin/actions/taxonomy-delete" style="display:inline;">
                  <CsrfInput token={Astro.locals.csrfToken} />
                  <input type="hidden" name="kind" value="category" />
                  <input type="hidden" name="id" value="" />
                  <button type="submit" class="admin-button small delete-button">{t("taxonomies.deleteCategory")}</button>
                </form>
              </div>
            </div>
          </dialog>
        </ap-confirm-dialog>
      </section>

      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("taxonomies.tags")}</h2>
            <p>{t("taxonomies.tagsDesc")}</p>
          </div>
        </div>
        <form class="stack-form" method="post" action="/ap-admin/actions/taxonomy-save">
          <CsrfInput token={Astro.locals.csrfToken} />
          <input type="hidden" name="kind" value="tag" />
          <label class="admin-field">
            <span>{t("taxonomies.tagName")}</span>
            <input aria-label={t("taxonomies.tagName")} type="text" name="name" placeholder="Volunteer Stories" class="admin-input" />
          </label>
          <label class="admin-field">
            <span>{t("taxonomies.slug")}</span>
            <input aria-label={t("taxonomies.tagSlug")} type="text" name="slug" placeholder="volunteer-stories" class="admin-input" />
          </label>
          <label class="admin-field">
            <span>{t("taxonomies.descriptionField")}</span>
            <textarea aria-label={t("taxonomies.tagDescription")} name="description" rows="2" class="admin-textarea"></textarea>
          </label>
          <button type="submit" class="admin-button">{t("taxonomies.saveTag")}</button>
        </form>
        <table aria-label={t("taxonomies.tags")}>
          <thead>
            <tr>
              <th>{t("taxonomies.thName")}</th>
              <th>{t("taxonomies.thSlug")}</th>
              <th>{t("common.actions")}</th>
            </tr>
          </thead>
          <tbody>
            {tags.map((term) => (
              <tr>
                <td>{term.name}</td>
                <td>{term.slug}</td>
                <td class="actions">
                  <details>
                    <summary class="edit-summary">{t("taxonomies.edit")}</summary>
                    <form method="post" action="/ap-admin/actions/taxonomy-save" class="inline-form">
                      <CsrfInput token={Astro.locals.csrfToken} />
                      <input type="hidden" name="kind" value="tag" />
                      <input type="hidden" name="id" value={term.id} />
                      <input aria-label={`${t("taxonomies.tagName")} ${term.slug}`} type="text" name="name" value={term.name} class="admin-input" />
                      <input aria-label={`${t("taxonomies.tagSlug")} ${term.slug}`} type="text" name="slug" value={term.slug} class="admin-input" />
                      <textarea aria-label={`${t("taxonomies.tagDescription")} ${term.slug}`} name="description" rows="2" class="admin-textarea">{term.description || ""}</textarea>
                      <button type="submit" class="admin-button small">{t("taxonomies.update")}</button>
                    </form>
                  </details>
                  <button
                    type="button"
                    class="admin-button-ghost small delete-button"
                    data-confirm-trigger
                    data-dialog-id="confirm-delete-tag"
                    data-field-name="id"
                    data-field-value={term.id}
                    data-text-tag-name={term.name}
                  >
                    {t("taxonomies.delete")}
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <ap-confirm-dialog>
          <dialog id="confirm-delete-tag" class="confirm-modal" aria-labelledby="confirm-delete-tag-title">
            <div class="modal-content">
              <h2 id="confirm-delete-tag-title">{t("taxonomies.deleteTagDialogTitle")}</h2>
              <p>{t("taxonomies.deleteConfirmPrefix")}<strong id="tag-name"></strong>{t("taxonomies.deleteConfirmSuffix")}</p>
              <p class="dialog-warning">{t("taxonomies.deleteWarning")}</p>
              <div class="modal-actions">
                <button type="button" class="admin-button-ghost small secondary-button" data-dialog-close>{t("taxonomies.cancel")}</button>
                <form method="post" action="/ap-admin/actions/taxonomy-delete" style="display:inline;">
                  <CsrfInput token={Astro.locals.csrfToken} />
                  <input type="hidden" name="kind" value="tag" />
                  <input type="hidden" name="id" value="" />
                  <button type="submit" class="admin-button small delete-button">{t("taxonomies.deleteTag")}</button>
                </form>
              </div>
            </div>
          </dialog>
        </ap-confirm-dialog>
      </section>
    </div>
    <script>
      import "../../web-components/confirm-dialog";
    </script>
    <AuditTrail
      events={auditEvents.filter((event) => event.action.startsWith("category.") || event.action.startsWith("tag.")).slice(0, 5)}
    />
    {/* Undo toast auto-dismisses via CSS animation (ap-toast-out in admin.css) */}
  </AdminLayout>
) : (
  <AdminLayout
    title={t("taxonomies.forbiddenTitle")}
    heading={t("taxonomies.forbiddenTitle")}
    currentPath=""
    description={t("pages.forbidden.description")}
    userName={safeAdminUserName(adminUser)}
  >
    <section class="panel forbidden">
      <p>{t("pages.forbidden.body")}</p>
    </section>
  </AdminLayout>
)}

<style>
  .taxonomy-grid {
    display: grid;
    gap: 1rem;
  }

  .stack-form,
  .inline-form {
    display: grid;
    gap: 0.75rem;
  }

  .delete-button {
    border-color: color-mix(in srgb, var(--danger) 50%, var(--line));
    color: var(--danger);
  }

  .actions {
    display: grid;
    gap: 0.5rem;
  }

  details summary {
    cursor: pointer;
    color: var(--accent);
    font-weight: 700;
  }

  .edit-summary {
    width: fit-content;
  }
</style>
