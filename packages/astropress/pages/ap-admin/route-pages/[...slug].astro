---
import { safeAdminUserName } from "astropress";
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import CsrfInput from "@astropress-diy/astropress/components/CsrfInput.astro";
import { parseSections, TEMPLATE_CATALOG } from "@astropress-diy/astropress/sections";
import {
	buildRoutePageEditorModel,
	getAdminLocalePair,
	getPageT,
	isAuthUserAdmin,
	resolveAdminLocale,
} from "astropress";

export const prerender = false;

const adminUser = Astro.locals.adminUser;
const slugSegments = Array.isArray(Astro.params.slug)
	? Astro.params.slug
	: Astro.params.slug
		? [Astro.params.slug]
		: [];
const routePath = `/${slugSegments.join("/")}`;
const model = await buildRoutePageEditorModel(Astro.locals, routePath, adminUser);
const isForbidden = !adminUser || !isAuthUserAdmin(adminUser);
const { pageRecord, englishOwner, effectiveTranslationState } = model.data;
const wasSaved = Astro.url.searchParams.get("saved") === "1";
const errorMessage =
	Astro.url.searchParams.get("error") === "1" ? Astro.url.searchParams.get("message") : "";
const localePair = getAdminLocalePair(routePath);
const localizedRoutePath = localePair?.localizedRoute;
const t = getPageT(resolveAdminLocale(Astro));

const parsedExisting = parseSections(pageRecord?.sections ?? null);
const existingSections = parsedExisting.ok ? parsedExisting.sections : [];
const sectionEditorState = JSON.stringify({
	sections: existingSections,
	templates: TEMPLATE_CATALOG,
}).replace(/<\/script/gi, "<\\/script");
// Translated label keys for the section editor live in `pageTemplates.*` and
// `sectionFields.*` (added in the labels translation pass). Until those keys
// are populated, the editor falls back to its own EN defaults via the
// `data-label-*` attributes below.
const templateLabels = JSON.stringify(
	Object.fromEntries(
		TEMPLATE_CATALOG.map((entry) => [
			entry.key,
			{ title: entry.defaultTitle, description: entry.defaultDescription },
		]),
	),
);
const fieldLabels = JSON.stringify({});

if (model.status === "forbidden") {
	Astro.response.status = 403;
}

if (model.status === "not_found") {
	Astro.response.status = 404;
}
---

{pageRecord && model.status !== "forbidden" ? (
  <AdminLayout
    title={`${t("routePageEditor.titlePrefix")} | ${pageRecord.title}`}
    heading={t("routePageEditor.title")}
    currentPath="/ap-admin/route-pages"
    description={t("routePageEditor.description")}
    userName={safeAdminUserName(adminUser)}
  >
    <nav class="breadcrumb" aria-label={t("routePageEditor.breadcrumb")}>
      <a href="/ap-admin/route-pages">{t("routePageEditor.routePagesLink")}</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{pageRecord.title || routePath}</span>
    </nav>
    {model.warnings.length > 0 && <p class="notice">{t("routePageEditor.partialResults")}</p>}
    <div class="toolbar">
      <a href="/ap-admin/pages" class="admin-button-secondary">{t("routePages.backToPages")}</a>
      <a href={pageRecord.path} target="_blank" rel="noreferrer" class="admin-button-ghost">{t("routePageEditor.openPublicPage")}</a>
      <a href="/ap-admin/route-pages" class="admin-button-ghost">{t("routePageEditor.openRouteTable")}</a>
    </div>
    {(wasSaved || Astro.url.searchParams.get("created") === "1") && <p class="notice">{t("routePageEditor.savedSuccess")}</p>}
    {errorMessage && <p class="error-notice">{errorMessage}</p>}

    <form method="post" action="/ap-admin/actions/route-page-save" class="edit-form">
      <CsrfInput token={Astro.locals.csrfToken} />
      <input type="hidden" name="path" value={pageRecord.path} />
      <input type="hidden" name="templateKey" value={pageRecord.templateKey} />

      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("routePageEditor.sectionsHeading")}</h2>
            <p>{t("routePageEditor.sectionsHeadingDesc")}</p>
          </div>
        </div>
        <p class="field-note">{t("routePageEditor.sectionsJsonNote")}</p>
        <div class="ap-editor-split">
          <ap-section-editor
            class="ap-section-editor"
            data-label-templates={templateLabels}
            data-label-fields={fieldLabels}
          >
            <script type="application/json" data-section-editor-state set:html={sectionEditorState}></script>
            <input type="hidden" id="sections-payload-input" name="sectionsJson" data-section-editor-input />
            <div data-section-editor-list class="ap-section-editor__list"></div>
            <div class="ap-section-editor__footer">
              <button type="button" class="admin-button" data-section-editor-add>
                {t("routePageEditor.addSection")}
              </button>
            </div>
            <dialog data-section-editor-add-dialog class="ap-section-editor__dialog" aria-labelledby="ap-section-editor-add-title">
              <div class="ap-section-editor__dialog-inner">
                <h3 id="ap-section-editor-add-title">{t("routePageEditor.addSectionDialogTitle")}</h3>
                <h4>{t("routePageEditor.startFromTemplate")}</h4>
                <div data-section-editor-templates class="ap-section-editor__picks"></div>
                <h4>{t("routePageEditor.orPickSectionType")}</h4>
                <div data-section-editor-kinds class="ap-section-editor__picks"></div>
                <button type="button" class="admin-button-ghost" data-section-editor-close>{t("routePageEditor.dialogClose")}</button>
              </div>
            </dialog>
          </ap-section-editor>
          <ap-page-preview for="sections-payload-input" stylesheet="/sections.css" class="ap-page-preview"></ap-page-preview>
        </div>
      </section>

      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("routePageEditor.general")}</h2>
            <p>{t("routePageEditor.generalDesc")}</p>
          </div>
        </div>
        <p class="field-note">{t("routePageEditor.publicRoute")} <a href={pageRecord.path} target="_blank" rel="noreferrer">{pageRecord.path}</a> · {t("routePageEditor.templateLabel")} <strong>{pageRecord.templateKey}</strong></p>
        <label class="admin-field">
          <span>{t("routePageEditor.titleField")}</span>
          <input type="text" aria-label={t("routePageEditor.titleFieldAria")} name="title" value={pageRecord.title} required class="admin-input" />
        </label>
        <label class="admin-field">
          <span>{t("routePageEditor.summary")}</span>
          <textarea aria-label={t("routePageEditor.summaryAria")} rows="3" name="summary" class="admin-textarea">{pageRecord.summary ?? ""}</textarea>
        </label>
        <label class="admin-field">
          <span>{t("routePageEditor.canonicalUrl")}</span>
          <input type="url" aria-label={t("routePageEditor.canonicalUrl")} name="canonicalUrlOverride" value={pageRecord.canonicalUrlOverride ?? ""} class="admin-input" />
        </label>
        <label class="admin-field">
          <span>{t("routePageEditor.robots")}</span>
          <input type="text" aria-label={t("routePageEditor.robotsAria")} name="robotsDirective" value={pageRecord.robotsDirective ?? ""} class="admin-input" />
        </label>
        <label class="admin-field">
          <span>{t("routePageEditor.ogImage")}</span>
          <input type="text" aria-label={t("routePageEditor.ogImageAria")} name="ogImage" value={pageRecord.ogImage ?? ""} class="admin-input" />
        </label>
      </section>

      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("routePageEditor.ownerLocale")}</h2>
            <p>{t("routePageEditor.ownerLocaleDesc")}</p>
          </div>
        </div>
        <p class="field-note">{t("routePageEditor.belongsToPagesWorkflow")}</p>
        <div class="editor-links">
          <a href="/ap-admin/pages" class="admin-button-ghost small">{t("routePageEditor.openPagesIndex")}</a>
          <a href={pageRecord.path} target="_blank" rel="noreferrer" class="admin-button-ghost small">{t("routePageEditor.openPublicRoute")}</a>
          {englishOwner && <a href={`/ap-admin/posts/${englishOwner.slug}`} class="admin-button-ghost small">{t("routePageEditor.editEnglishOwner")}</a>}
          {localePair?.englishRoute && localePair.englishRoute !== routePath && !englishOwner && (
            <a href={`/ap-admin/route-pages${localePair.englishRoute}`} class="admin-button-ghost small">{t("routePageEditor.editEnglishVariant")}</a>
          )}
          {localizedRoutePath && localizedRoutePath !== routePath && (
            <a href={`/ap-admin/route-pages${localizedRoutePath}`} class="admin-button-ghost small">{t("routePageEditor.editSpanishVariant")}</a>
          )}
        </div>
        {localizedRoutePath && (
          <div class="translation-inline-form">
            <input type="hidden" name="route" value={localizedRoutePath} />
            <input type="hidden" name="returnPath" value={`/ap-admin/route-pages${pageRecord.path}`} />
            <label class="admin-field">
              <span>{t("routePageEditor.translationState")}</span>
              <select name="state" aria-label={t("routePageEditor.translationState")} class="admin-select">
                <option value="not_started" selected={effectiveTranslationState === "not_started"}>{t("routePageEditor.stateNotStarted")}</option>
                <option value="partial" selected={effectiveTranslationState === "partial"}>{t("routePageEditor.statePartial")}</option>
                <option value="fallback_en" selected={effectiveTranslationState === "fallback_en"}>{t("routePageEditor.stateFallbackEn")}</option>
                <option value="translated" selected={effectiveTranslationState === "translated"}>{t("routePageEditor.stateTranslated")}</option>
                <option value="reviewed" selected={effectiveTranslationState === "reviewed"}>{t("routePageEditor.stateReviewed")}</option>
                <option value="published" selected={effectiveTranslationState === "published"}>{t("routePageEditor.statePublished")}</option>
              </select>
            </label>
            <button type="submit" formaction="/ap-admin/actions/translation-update" formmethod="post" class="admin-button small">{t("routePageEditor.updateTranslationState")}</button>
          </div>
        )}
      </section>

      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("routePageEditor.seoHeading")}</h2>
            <p>{t("routePageEditor.seoDesc")}</p>
          </div>
        </div>
        <label class="admin-field">
          <span>{t("routePageEditor.seoTitle")}</span>
          <input type="text" aria-label={t("routePageEditor.seoTitleAria")} name="seoTitle" value={pageRecord.seoTitle ?? pageRecord.title} class="admin-input" />
        </label>
        <label class="admin-field">
          <span>{t("routePageEditor.metaDescription")}</span>
          <textarea aria-label={t("routePageEditor.metaDescriptionAria")} rows="3" name="metaDescription" class="admin-textarea">{pageRecord.metaDescription ?? pageRecord.summary ?? ""}</textarea>
        </label>
      </section>

      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("routePageEditor.alternateLinks")}</h2>
            <p>{t("routePageEditor.alternateLinksDesc")}</p>
          </div>
        </div>
        {pageRecord.alternateLinks.length > 0 && (
          <p class="field-note">
            {pageRecord.alternateLinks.map((link) => (
              <a href={`/ap-admin/route-pages${link.href.replace(/^https?:\/\/[^/]+/, "")}`} class="admin-button-ghost small">{link.hreflang}</a>
            ))}
          </p>
        )}
        <textarea aria-label={t("routePageEditor.alternateLinksJsonAria")} rows="6" name="alternateLinksJson" class="admin-textarea code-field">{JSON.stringify(pageRecord.alternateLinks, null, 2)}</textarea>
      </section>

      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("routePageEditor.revisionNote")}</h2>
            <p>{t("routePageEditor.revisionNoteDesc")}</p>
          </div>
        </div>
        <input type="text" aria-label={t("routePageEditor.revisionNoteAria")} name="revisionNote" placeholder={t("routePageEditor.revisionNotePlaceholder")} class="admin-input" />
      </section>

      <div class="form-actions">
        <button type="submit" class="admin-button">{t("routePageEditor.saveRoutePage")}</button>
        <a href="/ap-admin/route-pages" class="admin-button-ghost secondary-button">{t("routePageEditor.backToRouteTable")}</a>
      </div>
    </form>
  </AdminLayout>
) : (
  <AdminLayout
    title={isForbidden ? t("routePages.forbiddenTitle") : t("routePageEditor.notFoundTitle")}
    heading={isForbidden ? t("routePages.forbiddenTitle") : t("routePageEditor.notFoundTitle")}
    currentPath="/ap-admin/route-pages"
    description={isForbidden ? t("routePages.forbiddenDesc") : t("routePageEditor.notFoundDesc")}
    userName={safeAdminUserName(adminUser)}
  >
    {isForbidden && (
      <section class="panel">
        <p>{t("routePages.forbiddenBody")}</p>
      </section>
    )}
  </AdminLayout>
)}

<style>
  .edit-form {
    display: grid;
    gap: 1rem;
  }

  .field-note {
    color: var(--muted);
    margin: 0;
  }

  .editor-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.85rem;
  }

  .field-note a {
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }

  .editor-links a:hover,
  .field-note a:hover {
    text-decoration: underline;
  }

  .translation-inline-form {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .translation-inline-form label {
    display: grid;
    gap: 0.45rem;
  }

  .translation-inline-form button {
    justify-self: start;
  }

  .form-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .code-field {
    font-family: monospace;
  }

  /* Section editor */
  .ap-section-editor { display: block; }
  .ap-section-editor__list { display: flex; flex-direction: column; gap: 0.75rem; }
  .ap-section-editor__empty {
    color: var(--muted);
    padding: 1.5rem;
    border: 1px dashed var(--line);
    border-radius: 0.5rem;
    text-align: center;
  }
  .ap-section-editor__footer { margin-block-start: 1rem; }
  .ap-section-card {
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--surface);
  }
  .ap-section-card--dragging { opacity: 0.5; }
  .ap-section-card__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--line);
  }
  .ap-section-card__handle {
    cursor: grab;
    background: transparent;
    border: 0;
    color: var(--muted);
    min-block-size: 44px;
    min-inline-size: 44px;
    padding: 0;
  }
  .ap-section-card__kind { font-weight: 600; flex: 1; }
  .ap-section-card__actions { display: flex; gap: 0.25rem; }
  .ap-section-card__actions button {
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 0.25rem;
    min-block-size: 44px;
    min-inline-size: 44px;
    cursor: pointer;
  }
  .ap-section-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem;
  }
  .ap-section-card__fieldset {
    border: 1px solid var(--line);
    border-radius: 0.375rem;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .ap-section-editor__dialog { border: 0; padding: 0; max-inline-size: min(40rem, 90vw); }
  .ap-section-editor__dialog-inner { padding: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .ap-section-editor__picks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: 0.5rem;
  }
  .ap-section-editor__pick {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    text-align: start;
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.375rem;
    background: var(--surface);
    cursor: pointer;
    min-block-size: 44px;
  }
  .ap-section-editor__pick:hover { background: var(--surface-hover, rgba(0, 0, 0, 0.04)); }
  .ap-section-card__media-row {
    display: flex;
    gap: 0.5rem;
    align-items: stretch;
  }
  .ap-section-card__media-row .admin-input { flex: 1; }
  .ap-section-card__media-row ap-media-picker { display: inline-flex; }

  /* Split-pane layout: editor + live preview */
  .ap-editor-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: start;
  }
  .ap-editor-split > .ap-section-editor[data-pp-hidden="true"] { display: none; }
  .ap-page-preview { display: flex; flex-direction: column; min-block-size: 24rem; }
  .ap-page-preview__tabs { display: none; gap: 0.25rem; margin-block-end: 0.5rem; }
  .ap-page-preview__tabs button {
    flex: 1;
    min-block-size: 44px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 0.375rem;
    cursor: pointer;
  }
  .ap-page-preview__tabs button[aria-selected="true"] {
    background: var(--accent, #0f172a);
    color: var(--accent-fg, #ffffff);
    border-color: transparent;
  }
  .ap-page-preview__frame {
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    overflow: hidden;
    background: #fff;
    flex: 1;
    min-block-size: 32rem;
  }
  .ap-page-preview__frame iframe {
    inline-size: 100%;
    block-size: 100%;
    min-block-size: 32rem;
    border: 0;
    display: block;
  }

  @media (max-width: 1023px) {
    .ap-editor-split { grid-template-columns: 1fr; }
    .ap-page-preview__tabs { display: flex; }
    .ap-page-preview[data-pp-active="edit"] .ap-page-preview__frame { display: none; }
  }
  @media (max-width: 720px) {
    .ap-section-card__body { padding: 0.5rem; }
    .ap-section-editor__picks { grid-template-columns: 1fr; }
  }
</style>
<script>
  import "../../../web-components/section-editor";
  import "../../../web-components/media-picker";
  import "../../../web-components/page-preview";
</script>
