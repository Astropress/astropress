---
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import RequiresIntegration from "@astropress-diy/astropress/components/RequiresIntegration.astro";
import {
	adminStubs,
	resolveAdminLocale,
	resolveAstropressAdminUiConfig,
} from "astropress";

const adminUser = Astro.locals.adminUser;
if (!adminUser || adminUser.role !== "admin") {
	return Astro.redirect("/ap-admin?error=insufficient-permissions");
}

const locale = resolveAdminLocale(Astro);
const ui = resolveAstropressAdminUiConfig(locale);
const stub = adminStubs.community;
---

<AdminLayout
  title={ui.navigation.community}
  heading={ui.navigation.community}
  currentPath="/ap-admin/community"
  description={stub.description}
  role={adminUser.role}
  userName={adminUser.name}
>
  <RequiresIntegration
    capability={stub.capability}
    description={stub.description}
    configHint={stub.configHint}
    providers={[...stub.providers]}
    docsHref={stub.docsHref}
    locale={locale}
  />
</AdminLayout>
