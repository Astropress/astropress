---
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import CsrfInput from "@astropress-diy/astropress/components/CsrfInput.astro";
import { resolveApiRuntime } from "@astropress-diy/astropress/admin-store-dispatch.js";
import { getPageT, requiresAccess, resolveAdminLocale } from "astropress";

const guard = await requiresAccess(Astro, "apiTokens:create");
if (guard) return guard;
const adminUser = Astro.locals.adminUser;
if (!adminUser) return Astro.redirect("/ap-admin/login");
const t = getPageT(resolveAdminLocale(Astro));

const { apiTokens } = await resolveApiRuntime(Astro.locals);
const tokens = apiTokens ? await apiTokens.list() : [];

const wasCreated = Astro.url.searchParams.get("created") === "1";
const wasRevoked = Astro.url.searchParams.get("revoked") === "1";
const createdRawToken = wasCreated ? Astro.url.searchParams.get("rawToken") : null;
const errorMessage =
	Astro.url.searchParams.get("error") === "1" ? Astro.url.searchParams.get("message") : null;

const ALL_SCOPES = [
	"content:read",
	"content:write",
	"media:read",
	"media:write",
	"settings:read",
	"webhooks:manage",
] as const;
---

<AdminLayout
  title={t("apiTokens.title")}
  heading={t("apiTokens.title")}
  currentPath="/ap-admin/api-tokens"
  description={t("apiTokens.description")}
  userName={adminUser.name}
>
  {wasRevoked && <p class="notice">{t("apiTokens.revokedSuccess")}</p>}
  {errorMessage && <p class="error-notice">{errorMessage}</p>}

  {wasCreated && createdRawToken && (
    <div class="panel notice" style="border-inline-start: 4px solid var(--color-success, green); padding: 1rem;">
      <strong>{t("apiTokens.created")}</strong> {t("apiTokens.copyNow")}
      <br />
      <code style="word-break: break-all; font-size: 0.9em;">{createdRawToken}</code>
    </div>
  )}

  <section class="panel">
    <div class="section-header">
      <div>
        <p class="admin-kicker">{t("apiTokens.createKicker")}</p>
        <h2>{t("apiTokens.newToken")}</h2>
      </div>
    </div>
    <form method="post" action="/ap-admin/actions/api-token-create" class="admin-form-grid">
      <CsrfInput token={Astro.locals.csrfToken} />
      <label class="admin-field">
        <span>{t("apiTokens.label")}</span>
        <input type="text" name="label" placeholder={t("apiTokens.labelPlaceholder")} required class="admin-input" />
      </label>
      <fieldset class="admin-field">
        <legend>{t("apiTokens.scopes")}</legend>
        {ALL_SCOPES.map((scope) => (
          <label class="admin-checkbox">
            <input type="checkbox" name="scopes" value={scope} />
            {scope}
          </label>
        ))}
      </fieldset>
      <button type="submit" class="admin-button">{t("apiTokens.createButton")}</button>
    </form>
  </section>

  <section class="panel">
    <h2>{t("apiTokens.existingTokens")}</h2>
    {tokens.length === 0 ? (
      <p>{t("apiTokens.noTokens")}</p>
    ) : (
      <table class="admin-table">
        <thead>
          <tr>
            <th>{t("apiTokens.label")}</th>
            <th>{t("apiTokens.scopes")}</th>
            <th>{t("apiTokens.colCreated")}</th>
            <th>{t("apiTokens.colLastUsed")}</th>
            <th>{t("common.status")}</th>
            <th>{t("common.actions")}</th>
          </tr>
        </thead>
        <tbody>
          {tokens.map((token) => (
            <tr>
              <td>{token.label}</td>
              <td>{token.scopes.join(", ")}</td>
              <td>{token.createdAt ? new Date(token.createdAt).toLocaleDateString() : "—"}</td>
              <td>{token.lastUsedAt ? new Date(token.lastUsedAt).toLocaleDateString() : t("apiTokens.never")}</td>
              <td>{token.revokedAt ? <span style="color: var(--danger, #991b1b);">{t("apiTokens.revoked")}</span> : <span style="color: #14532d;">{t("apiTokens.active")}</span>}</td>
              <td>
                {!token.revokedAt && (
                  <button
                    type="button"
                    class="admin-button-ghost small delete-button"
                    data-confirm-trigger
                    data-dialog-id="confirm-revoke-token"
                    data-field-name="id"
                    data-field-value={token.id}
                    data-text-token-label={token.label}
                  >
                    {t("apiTokens.revoke")}
                  </button>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </section>
  <ap-confirm-dialog>
    <dialog id="confirm-revoke-token" class="confirm-modal" aria-labelledby="confirm-revoke-token-title">
      <div class="modal-content">
        <h2 id="confirm-revoke-token-title">{t("apiTokens.confirmTitle")}</h2>
        <p>{t("apiTokens.confirmBody")} <strong id="token-label"></strong>?</p>
        <p class="dialog-warning">{t("apiTokens.confirmWarning")}</p>
        <div class="modal-actions">
          <button type="button" class="admin-button-ghost small secondary-button" data-dialog-close>{t("apiTokens.cancel")}</button>
          <form method="post" action="/ap-admin/actions/api-token-revoke" style="display:inline;">
            <CsrfInput token={Astro.locals.csrfToken} />
            <input type="hidden" name="id" value="" />
            <button type="submit" class="admin-button small delete-button">{t("apiTokens.revokeButton")}</button>
          </form>
        </div>
      </div>
    </dialog>
  </ap-confirm-dialog>
  <script>
    import "../../web-components/confirm-dialog";
  </script>
</AdminLayout>
