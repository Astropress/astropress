---
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import {
	buildArchivesIndexPageModel,
	getPageT,
	resolveAdminLocale,
} from "astropress";

const adminUser = Astro.locals.adminUser;
const model = await buildArchivesIndexPageModel(Astro.locals, adminUser?.role);
if (model.status === "forbidden") {
	Astro.response.status = 403;
}
const { archiveList, kindCounts, totalArchives, totalItems } = model.data;
const t = getPageT(resolveAdminLocale(Astro));
---

{model.status !== "forbidden" ? (
<AdminLayout
  title={t("archives.title")}
  heading={t("archives.title")}
  description={t("archives.description")}
  role={adminUser!.role}
  userName={adminUser!.name}
  currentPath="/ap-admin/archives"
>
  {model.warnings.length > 0 && <p class="notice">{t("archives.partialResults")}</p>}
  <div class="toolbar">
    <a href="/ap-admin/pages" class="admin-button-secondary">{t("archives.backToPages")}</a>
    <a href="/ap-admin/posts" class="admin-button-ghost">{t("archives.managePosts")}</a>
  </div>
  <div class="grid two">
    <div class="panel stat">
      <strong>{totalArchives}</strong>
      <p>{t("archives.totalArchives")}</p>
    </div>
    <div class="panel stat">
      <strong>{totalItems}</strong>
      <p>{t("archives.totalListingItems")}</p>
    </div>
  </div>

  <section class="panel section-space">
    <div class="section-header">
      <div>
        <h2>{t("archives.archivesByKind")}</h2>
        <p>{t("archives.archivesByKindDesc")}</p>
      </div>
    </div>
    <div class="grid two">
      {
        kindCounts.map((stat) => (
          <div class="kind-stat">
            <strong>{stat.count}</strong>
            <p>{stat.kind}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="panel section-space overflow-table">
    <div class="section-header">
      <div>
        <h2>{t("archives.allArchives")}</h2>
        <p>{t("archives.allArchivesDesc")}</p>
      </div>
    </div>
    <table>
      <thead>
        <tr>
          <th>{t("common.title")}</th>
          <th>{t("archives.kind")}</th>
          <th>{t("archives.slug")}</th>
          <th class="right">{t("archives.items")}</th>
          <th>{t("common.actions")}</th>
        </tr>
      </thead>
      <tbody>
        {
          archiveList.map((archive) => (
            <tr>
              <td>
                <a href={`/ap-admin/archives/${archive.slug}`}>{archive.title}</a>
              </td>
              <td>
                <span class="kind-chip">{archive.kind}</span>
              </td>
              <td><code>{archive.slug}</code></td>
              <td class="right muted">{archive.listingItems?.length || 0}</td>
              <td>
                <div class="row-actions">
                  <a href={`/ap-admin/archives/${archive.slug}`} class="admin-button-ghost small">{t("archives.editArchive")}</a>
                  <a href={archive.legacyUrl} target="_blank" rel="noreferrer" class="admin-button-ghost small">{t("archives.openArchive")}</a>
                </div>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <p class="archive-note">
    <strong>{t("archives.noteStrong")}</strong> {t("archives.noteBody")}
  </p>
</AdminLayout>
) : (
  <AdminLayout
    title={t("archives.forbiddenTitle")}
    heading={t("archives.forbiddenTitle")}
    description={t("archives.forbiddenDesc")}
    role={adminUser!.role}
    userName={adminUser!.name}
    currentPath="/ap-admin/posts"
  >
    <section class="panel">
      <p>{t("archives.forbiddenBody")}</p>
    </section>
  </AdminLayout>
)}

<style>
  h2 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  table {
    font-size: 0.95rem;
  }

  th {
    background: var(--bg);
    font-weight: 700;
  }

  tr:hover {
    background: var(--bg);
  }

  code {
    font-family: "Monaco", "Courier New", monospace;
    font-size: 0.85rem;
  }

  .section-space {
    margin-top: 1.5rem;
  }

  .overflow-table {
    overflow-x: auto;
  }

  .kind-stat strong {
    color: var(--accent);
    font-size: 1.2rem;
  }

  .kind-stat p {
    margin: 0.25rem 0 0;
    color: var(--muted);
  }

  .kind-chip {
    display: inline-flex;
    padding: 0.25rem 0.6rem;
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .row-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .archive-note,
  .muted {
    color: var(--muted);
  }

  .archive-note {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    max-width: 68ch;
  }

  .right {
    text-align: right;
  }
</style>
