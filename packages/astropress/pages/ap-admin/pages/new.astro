---
import { safeAdminUserName } from "astropress";
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import CsrfInput from "@astropress-diy/astropress/components/CsrfInput.astro";
import { getPageT, isAuthUserAdmin, resolveAdminLocale } from "astropress";

const adminUser = Astro.locals.adminUser;
const t = getPageT(resolveAdminLocale(Astro));

if (!adminUser || !isAuthUserAdmin(adminUser)) {
	Astro.response.status = 403;
}

const errorMessage =
	Astro.url.searchParams.get("error") === "1" ? Astro.url.searchParams.get("message") : "";
---

{adminUser && isAuthUserAdmin(adminUser) ? (
  <AdminLayout
    title={t("pagesNew.title")}
    heading={t("pagesNew.heading")}
    currentPath="/ap-admin/pages"
    description={t("pagesNew.description")}
    userName={safeAdminUserName(adminUser)}
  >
    {errorMessage && <p class="error-notice">{errorMessage}</p>}

    <form method="post" action="/ap-admin/actions/route-page-create" class="edit-form">
      <CsrfInput token={Astro.locals.csrfToken} />

      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("pagesNew.generalHeading")}</h2>
            <p>{t("pagesNew.generalDesc")}</p>
          </div>
        </div>
        <label class="admin-field">
          <span>{t("pagesNew.titleField")}</span>
          <input type="text" name="title" aria-label={t("pagesNew.titleAria")} required class="admin-input" />
        </label>
        <label class="admin-field">
          <span>{t("pagesNew.publicPath")}</span>
          <input type="text" name="path" aria-label={t("pagesNew.publicPathAria")} placeholder="/new-page" required class="admin-input" />
        </label>
        <label class="admin-field">
          <span>{t("pagesNew.summaryField")}</span>
          <textarea name="summary" aria-label={t("pagesNew.summaryAria")} rows="3" class="admin-textarea"></textarea>
        </label>
      </section>

      <section class="panel">
        <div class="section-header">
          <div>
            <h2>{t("pagesNew.seoHeading")}</h2>
            <p>{t("pagesNew.seoDescOptional")}</p>
          </div>
        </div>
        <label class="admin-field">
          <span>{t("pagesNew.seoTitleField")} <em class="admin-field__hint">{t("pagesNew.optionalHint")}</em></span>
          <input type="text" name="seoTitle" aria-label={t("pagesNew.seoTitleAria")} class="admin-input" />
        </label>
        <label class="admin-field">
          <span>{t("pagesNew.metaDescriptionField")} <em class="admin-field__hint">{t("pagesNew.optionalHint")}</em></span>
          <textarea name="metaDescription" aria-label={t("pagesNew.metaDescriptionAria")} rows="3" class="admin-textarea"></textarea>
        </label>
      </section>

      <div class="form-actions">
        <button type="submit" class="admin-button">{t("pagesNew.createPage")}</button>
        <a href="/ap-admin/pages" class="admin-button-ghost secondary-button">{t("pagesNew.cancel")}</a>
      </div>
    </form>
  </AdminLayout>
) : (
  <AdminLayout
    title={t("pagesNew.forbiddenTitle")}
    heading={t("pagesNew.forbiddenHeading")}
    currentPath="/ap-admin/posts"
    description={t("pagesNew.forbiddenDesc")}
    userName={safeAdminUserName(adminUser)}
  >
    <section class="panel">
      <p>{t("pagesNew.forbiddenBody")}</p>
    </section>
  </AdminLayout>
)}
