---
import { safeAdminUserName } from "astropress";
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import { getAstropressServices } from "@astropress-diy/astropress/services-config";
import { getPageT, isAuthUserAdmin, resolveAdminLocale } from "astropress";

const adminUser = Astro.locals.adminUser;
if (!adminUser || !isAuthUserAdmin(adminUser)) {
	Astro.response.status = 403;
}

const services = getAstropressServices();
const t = getPageT(resolveAdminLocale(Astro));

const DEFAULT_SERVICE_DOCS: Record<string, { docs: string; badge: string }> = {
	cms: {
		docs: "https://payloadcms.com/docs",
		badge: "MIT · Payload / Keystatic / Directus",
	},
	shop: {
		docs: "https://docs.medusajs.com",
		badge: "MIT · Medusa / Vendure",
	},
	community: {
		docs: "https://remark42.com/docs",
		badge: "MIT · Giscus / Remark42",
	},
	email: {
		docs: "https://listmonk.app/docs",
		badge: "MIT · Listmonk / Keila",
	},
};
---

<AdminLayout
  title={t("services.title")}
  heading={t("services.title")}
  currentPath="/ap-admin/services"
  description={t("services.description")}
  userName={safeAdminUserName(adminUser)}
>
  {services.length === 0 ? (
    <section class="panel empty-services">
      <div class="section-header">
        <div>
          <p class="admin-kicker">{t("services.emptyKicker")}</p>
          <h2>{t("services.emptyHeading")}</h2>
          <p>{t("services.emptyIntro")}</p>
        </div>
      </div>
      <div class="service-grid">
        {(["cms", "shop", "community", "email"] as const).map((provider) => (
          <div class="service-card service-card--inactive">
            <div class="service-card__header">
              <span class="service-badge">{DEFAULT_SERVICE_DOCS[provider].badge}</span>
              <strong class="service-name">{provider.charAt(0).toUpperCase() + provider.slice(1)}</strong>
            </div>
            <p class="service-description">
              {provider === "cms" && t("services.cmsDescription")}
              {provider === "shop" && t("services.shopDescription")}
              {provider === "community" && t("services.communityDescription")}
              {provider === "email" && t("services.emailDescription")}
            </p>
            <a href={DEFAULT_SERVICE_DOCS[provider].docs} target="_blank" rel="noreferrer" class="admin-button-ghost small">
              {t("services.viewDocs")}
            </a>
          </div>
        ))}
      </div>
      <p class="setup-note">
        {t("services.setupNoteBefore")} <code>registerAstropressService(&#123;&#125;)</code> {t("services.setupNoteMiddle")} <code>astro.config.mjs</code> {t("services.setupNoteAfter")}
        {t("services.seeDocsBefore")} <a href="https://github.com/withastro/astropress" target="_blank" rel="noreferrer">{t("services.seeDocsLink")}</a> {t("services.seeDocsAfter")}
      </p>
    </section>
  ) : (
    <div class="service-grid">
      {services.map((service) => (
        <a href={service.adminPath} class="service-card service-card--active">
          <div class="service-card__header">
            <span class="service-badge">{service.provider}</span>
            <strong class="service-name">{service.label}</strong>
          </div>
          <p class="service-description">{service.description}</p>
          <span class="open-label">{t("services.openAdmin")}</span>
        </a>
      ))}
    </div>
  )}
</AdminLayout>

<style>
  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .service-card {
    display: grid;
    gap: 0.6rem;
    padding: 1.1rem;
    border-radius: 0.95rem;
    border: 1px solid var(--line);
    background: var(--panel);
    text-decoration: none;
    color: inherit;
  }

  .service-card--active {
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }

  .service-card--active:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--panel) 94%, var(--accent) 6%);
  }

  .service-card--inactive {
    color: var(--muted, #374151);
  }

  .service-card__header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .service-name {
    font-size: 1.05rem;
    color: var(--text, #17212c);
  }

  .service-badge {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 0.2em 0.55em;
    border-radius: 0.4em;
    background: var(--accent-soft);
    color: var(--text, #17212c);
  }

  .service-description {
    margin: 0;
    color: var(--text, #17212c);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .open-label {
    font-size: 0.9rem;
    color: var(--accent);
    font-weight: 600;
  }

  .empty-services {
    padding: 1.5rem;
  }

  .setup-note {
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .setup-note code {
    font-family: monospace;
    background: var(--surface);
    padding: 0.1em 0.4em;
    border-radius: 0.3em;
  }
</style>
