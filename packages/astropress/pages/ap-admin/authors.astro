---
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import AuditTrail from "@astropress-diy/astropress/components/AuditTrail.astro";
import CsrfInput from "@astropress-diy/astropress/components/CsrfInput.astro";
import {
	buildAuthorsPageModel,
	getPageT,
	resolveAdminLocale,
} from "astropress";

const adminUser = Astro.locals.adminUser;
const model = await buildAuthorsPageModel(Astro.locals, adminUser);
const { authors, auditEvents } = model.data;
const wasSaved = Astro.url.searchParams.get("saved") === "1";
const wasDeleted = Astro.url.searchParams.get("deleted") === "1";
const restoreTable = Astro.url.searchParams.get("restore_table") ?? "";
const restoreId = Astro.url.searchParams.get("restore_id") ?? "";
const errorMessage =
	Astro.url.searchParams.get("error") === "1"
		? Astro.url.searchParams.get("message")
		: "";
const t = getPageT(resolveAdminLocale(Astro));

if (model.status === "forbidden") {
	Astro.response.status = 403;
}
---

{model.status !== "forbidden" ? (
  <AdminLayout
    title={t("authors.title")}
    heading={t("authors.title")}
    currentPath="/ap-admin/authors"
    description={t("authors.description")}
    userName={adminUser.name}
  >
    {model.warnings.length > 0 && <p class="notice">{t("authors.partialResults")}</p>}
    {wasSaved && <p class="notice">{t("authors.savedSuccess")}</p>}
    {wasDeleted && restoreId && (
      <div class="undo-toast" role="status" aria-live="polite" data-undo-toast>
        {t("authors.deletedToast")}
        <form method="post" action="/ap-admin/actions/restore" style="display:contents">
          <input type="hidden" name="_csrf" value={Astro.locals.csrfToken} />
          <input type="hidden" name="table" value={restoreTable} />
          <input type="hidden" name="id" value={restoreId} />
          <input type="hidden" name="return_to" value="/ap-admin/authors" />
          <button type="submit" class="undo-btn">{t("authors.undo")}</button>
        </form>
      </div>
    )}
    {wasDeleted && !restoreId && <p class="notice">{t("authors.deletedSuccess")}</p>}
    {errorMessage && <p class="error-notice">{errorMessage}</p>}

    <form class="panel stack-form" method="post" action="/ap-admin/actions/author-save">
      <CsrfInput token={Astro.locals.csrfToken} />
      <div class="section-header">
        <div>
          <h2>{t("authors.newAuthor")}</h2>
          <p>{t("authors.newAuthorDesc")}</p>
        </div>
      </div>
      <label class="admin-field">
        <span>{t("authors.authorName")}</span>
        <input aria-label={t("authors.authorName")} type="text" name="name" placeholder="Maria Rivera" class="admin-input" />
      </label>
      <label class="admin-field">
        <span>{t("authors.slug")}</span>
        <input aria-label={t("authors.authorSlug")} type="text" name="slug" placeholder="maria-rivera" class="admin-input" />
      </label>
      <label class="admin-field">
        <span>{t("authors.bio")}</span>
        <textarea aria-label={t("authors.authorBio")} name="bio" rows="3" placeholder={t("authors.bioPlaceholder")} class="admin-textarea"></textarea>
      </label>
      <button type="submit" class="admin-button">{t("authors.saveAuthor")}</button>
    </form>

    <section class="panel">
      <div class="section-header">
        <div>
          <h2>{t("authors.title")}</h2>
          <p>{t("authors.listDesc")}</p>
        </div>
      </div>
      <table aria-label={t("authors.tableAria")}>
        <thead>
          <tr>
            <th>{t("authors.thName")}</th>
            <th>{t("authors.thSlug")}</th>
            <th>{t("authors.thBio")}</th>
            <th>{t("common.actions")}</th>
          </tr>
        </thead>
        <tbody>
          {authors.map((author) => (
            <tr>
              <td>{author.name}</td>
              <td>{author.slug}</td>
              <td>{author.bio || "-"}</td>
              <td class="actions">
                <details>
                  <summary class="edit-summary">{t("authors.edit")}</summary>
                  <form method="post" action="/ap-admin/actions/author-save" class="inline-form">
                    <CsrfInput token={Astro.locals.csrfToken} />
                    <input type="hidden" name="id" value={author.id} />
                    <input aria-label={`${t("authors.ariaName")} ${author.slug}`} type="text" name="name" value={author.name} class="admin-input" />
                    <input aria-label={`${t("authors.ariaSlug")} ${author.slug}`} type="text" name="slug" value={author.slug} class="admin-input" />
                    <textarea aria-label={`${t("authors.ariaBio")} ${author.slug}`} name="bio" rows="2" class="admin-textarea">{author.bio || ""}</textarea>
                    <button type="submit" class="admin-button small">{t("authors.update")}</button>
                  </form>
                </details>
                <button
                  type="button"
                  class="admin-button-ghost small delete-button"
                  data-confirm-trigger
                  data-dialog-id="confirm-delete-author"
                  data-field-name="id"
                  data-field-value={author.id}
                  data-text-author-name={author.name}
                >
                  {t("authors.delete")}
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
    <ap-confirm-dialog>
      <dialog id="confirm-delete-author" class="confirm-modal" aria-labelledby="confirm-delete-author-title">
        <div class="modal-content">
          <h2 id="confirm-delete-author-title">{t("authors.deleteDialogTitle")}</h2>
          <p>{t("authors.deleteConfirmPrefix")}<strong id="author-name"></strong>{t("authors.deleteConfirmSuffix")}</p>
          <p class="dialog-warning">{t("authors.deleteWarning")}</p>
          <div class="modal-actions">
            <button type="button" class="admin-button-ghost small secondary-button" data-dialog-close>{t("authors.cancel")}</button>
            <form method="post" action="/ap-admin/actions/author-delete" style="display:inline;">
              <CsrfInput token={Astro.locals.csrfToken} />
              <input type="hidden" name="id" value="" />
              <button type="submit" class="admin-button small delete-button">{t("authors.deleteAuthor")}</button>
            </form>
          </div>
        </div>
      </dialog>
    </ap-confirm-dialog>
    <script>
      import "../../web-components/confirm-dialog";
    </script>
    <AuditTrail events={auditEvents.filter((event) => event.action.startsWith("author.")).slice(0, 5)} />
    {/* Undo toast auto-dismisses via CSS animation (ap-toast-out in admin.css) */}
  </AdminLayout>
) : (
  <AdminLayout
    title={t("authors.forbiddenTitle")}
    heading={t("authors.forbiddenTitle")}
    currentPath=""
    description={t("pages.forbidden.description")}
    userName={adminUser.name}
  >
    <section class="panel forbidden">
      <p>{t("pages.forbidden.body")}</p>
    </section>
  </AdminLayout>
)}

<style>
  .stack-form,
  .inline-form {
    display: grid;
    gap: 0.75rem;
  }

  .delete-button {
    border-color: color-mix(in srgb, var(--danger) 50%, var(--line));
    color: var(--danger);
  }

  .actions {
    display: grid;
    gap: 0.5rem;
  }

  details summary {
    cursor: pointer;
    color: var(--accent);
    font-weight: 700;
  }

  .edit-summary {
    width: fit-content;
  }
</style>
