---
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import CsrfInput from "@astropress-diy/astropress/components/CsrfInput.astro";
import { resolveApiRuntime } from "@astropress-diy/astropress/admin-store-dispatch.js";
import { getPageT, requiresAccess, resolveAdminLocale } from "astropress";

const guard = await requiresAccess(Astro, "webhooks:manage");
if (guard) return guard;
const adminUser = Astro.locals.adminUser;
if (!adminUser) return Astro.redirect("/ap-admin/login");
const t = getPageT(resolveAdminLocale(Astro));

const { webhooks: webhookStore } = await resolveApiRuntime(Astro.locals);
const webhooks = webhookStore ? await webhookStore.list() : [];

const wasCreated = Astro.url.searchParams.get("created") === "1";
const wasDeleted = Astro.url.searchParams.get("deleted") === "1";
const createdAlgorithm = wasCreated ? Astro.url.searchParams.get("algorithm") : null;
const createdPublicKey = wasCreated ? Astro.url.searchParams.get("publicKey") : null;
const errorMessage =
	Astro.url.searchParams.get("error") === "1" ? Astro.url.searchParams.get("message") : null;

const ALL_EVENTS = [
	"content.published",
	"content.updated",
	"content.deleted",
	"media.uploaded",
	"media.deleted",
] as const;
---

<AdminLayout
  title={t("webhooks.title")}
  heading={t("webhooks.title")}
  currentPath="/ap-admin/webhooks"
  description={t("webhooks.description")}
  userName={adminUser.name}
>
  {wasDeleted && <p class="notice">{t("webhooks.deletedSuccess")}</p>}
  {errorMessage && <p class="error-notice">{errorMessage}</p>}

  {wasCreated && createdAlgorithm && createdPublicKey && (
    <div class="panel notice" style="border-inline-start: 4px solid var(--color-success, green); padding: 1rem;">
      <strong>{t("webhooks.created")}</strong> {t("webhooks.copyBundle")}
      {t("webhooks.useToVerify")} <code>X-Astropress-Signature</code> {t("webhooks.headerSuffix")}
      <br />
      <code style="word-break: break-all; font-size: 0.9em;">{JSON.stringify({ algorithm: createdAlgorithm, publicKey: createdPublicKey })}</code>
    </div>
  )}

  <section class="panel">
    <div class="section-header">
      <div>
        <p class="admin-kicker">{t("webhooks.registerKicker")}</p>
        <h2>{t("webhooks.newWebhook")}</h2>
      </div>
    </div>
    <form method="post" action="/ap-admin/actions/webhook-create" class="admin-form-grid">
      <CsrfInput token={Astro.locals.csrfToken} />
      <label class="admin-field">
        <span>{t("webhooks.endpointUrl")}</span>
        <input type="url" name="url" placeholder="https://your-server.com/hooks" required class="admin-input" />
      </label>
      <fieldset class="admin-field">
        <legend>{t("webhooks.events")}</legend>
        {ALL_EVENTS.map((event) => (
          <label class="admin-checkbox">
            <input type="checkbox" name="events" value={event} />
            {event}
          </label>
        ))}
      </fieldset>
      <button type="submit" class="admin-button">{t("webhooks.registerButton")}</button>
    </form>
  </section>

  <section class="panel">
    <h2>{t("webhooks.activeWebhooks")}</h2>
    {webhooks.length === 0 ? (
      <p>{t("webhooks.noWebhooks")}</p>
    ) : (
      <table class="admin-table">
        <thead>
          <tr>
            <th>{t("webhooks.colUrl")}</th>
            <th>{t("webhooks.events")}</th>
            <th>{t("webhooks.colCreated")}</th>
            <th>{t("webhooks.colLastFired")}</th>
            <th>{t("common.actions")}</th>
          </tr>
        </thead>
        <tbody>
          {webhooks.map((wh) => (
            <tr>
              <td style="font-family: monospace; font-size: 0.85em; word-break: break-all;">{wh.url}</td>
              <td>{wh.events.join(", ")}</td>
              <td>{wh.createdAt ? new Date(wh.createdAt).toLocaleDateString() : "—"}</td>
              <td>{wh.lastFiredAt ? new Date(wh.lastFiredAt).toLocaleDateString() : t("webhooks.never")}</td>
              <td>
                <button
                  type="button"
                  class="admin-button-ghost small delete-button"
                  data-confirm-trigger
                  data-dialog-id="confirm-delete-webhook"
                  data-field-name="id"
                  data-field-value={wh.id}
                  data-text-webhook-url={wh.url}
                >
                  {t("webhooks.delete")}
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </section>
  <ap-confirm-dialog>
    <dialog id="confirm-delete-webhook" class="confirm-modal" aria-labelledby="confirm-delete-webhook-title">
      <div class="modal-content">
        <h2 id="confirm-delete-webhook-title">{t("webhooks.confirmTitle")}</h2>
        <p>{t("webhooks.confirmBody")} <strong id="webhook-url"></strong>?</p>
        <p class="dialog-warning">{t("webhooks.confirmWarning")}</p>
        <div class="modal-actions">
          <button type="button" class="admin-button-ghost small secondary-button" data-dialog-close>{t("webhooks.cancel")}</button>
          <form method="post" action="/ap-admin/actions/webhook-delete" style="display:inline;">
            <CsrfInput token={Astro.locals.csrfToken} />
            <input type="hidden" name="id" value="" />
            <button type="submit" class="admin-button small delete-button">{t("webhooks.deleteButton")}</button>
          </form>
        </div>
      </div>
    </dialog>
  </ap-confirm-dialog>
  <script>
    import "../../web-components/confirm-dialog";
  </script>
</AdminLayout>
