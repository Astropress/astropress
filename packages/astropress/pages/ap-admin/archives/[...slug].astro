---
import { safeAdminUserName } from "astropress";
import AdminLayout from "@astropress-diy/astropress/components/AdminLayout.astro";
import CsrfInput from "@astropress-diy/astropress/components/CsrfInput.astro";
import { buildArchiveEditorModel, getPageT, isAuthUserAdmin, resolveAdminLocale } from "astropress";

export const prerender = false;

const adminUser = Astro.locals.adminUser;
const slugValue = Array.isArray(Astro.params.slug)
	? Astro.params.slug.join("/")
	: (Astro.params.slug ?? "");
const archivePath = `/${slugValue}`;
const model = await buildArchiveEditorModel(Astro.locals, archivePath, adminUser);
const isForbidden = !adminUser || !isAuthUserAdmin(adminUser);
const { archive } = model.data;
const wasSaved = Astro.url.searchParams.get("saved") === "1";
const errorMessage =
	Astro.url.searchParams.get("error") === "1" ? Astro.url.searchParams.get("message") : "";
const t = getPageT(resolveAdminLocale(Astro));

if (model.status === "forbidden") {
	Astro.response.status = 403;
}

if (model.status === "not_found") {
	Astro.response.status = 404;
}
---

{archive && model.status !== "forbidden" ? (
  <AdminLayout
    title={`${t("archiveEditor.title")} | ${archive.title}`}
    heading={t("archiveEditor.title")}
    currentPath="/ap-admin/archives"
    description={t("archiveEditor.description")}
    userName={safeAdminUserName(adminUser)}
  >
    <nav class="breadcrumb" aria-label={t("archiveEditor.breadcrumb")}>
      <a href="/ap-admin/archives">{t("archiveEditor.archivesLink")}</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{archive.title || slugValue}</span>
    </nav>
    {model.warnings.length > 0 && <p class="notice">{t("archiveEditor.partialResults")}</p>}
    <div class="toolbar">
      <a href="/ap-admin/archives">{t("archiveEditor.backToArchives")}</a>
      <a href={archive.path} target="_blank" rel="noreferrer">{t("archiveEditor.openPublicArchive")}</a>
      <a href="/ap-admin/posts">{t("archiveEditor.manageInPosts")}</a>
    </div>
    {wasSaved && <p class="notice">{t("archiveEditor.savedSuccess")}</p>}
    {errorMessage && <p class="error-notice">{errorMessage}</p>}
    <form method="post" action="/ap-admin/actions/archive-save" class="archive-form">
      <CsrfInput token={Astro.locals.csrfToken} />
      <input type="hidden" name="path" value={archive.path} />
      <section class="panel">
        <h3>{t("archiveEditor.metadataHeading")}</h3>
        <p class="field-note">{t("archiveEditor.publicArchiveRoute")} <a href={archive.path} target="_blank" rel="noreferrer">{archive.path}</a></p>
        <label>
          <span>{t("archiveEditor.titleField")}</span>
          <input type="text" name="title" value={archive.title} required />
        </label>
        <label>
          <span>{t("archiveEditor.summary")}</span>
          <textarea name="summary" rows="5">{archive.summary ?? ""}</textarea>
        </label>
        <label>
          <span>{t("archiveEditor.seoTitle")}</span>
          <input type="text" name="seoTitle" value={archive.seoTitle ?? archive.title} />
        </label>
        <label>
          <span>{t("archiveEditor.metaDescription")}</span>
          <textarea name="metaDescription" rows="4">{archive.metaDescription ?? ""}</textarea>
        </label>
        <label>
          <span>{t("archiveEditor.canonicalUrlOverride")}</span>
          <input type="url" name="canonicalUrlOverride" value={archive.canonicalUrlOverride ?? ""} />
        </label>
        <label>
          <span>{t("archiveEditor.robotsDirective")}</span>
          <input type="text" name="robotsDirective" value={archive.robotsDirective ?? ""} />
        </label>
        <label>
          <span>{t("archiveEditor.revisionNote")}</span>
          <input type="text" name="revisionNote" placeholder={t("archiveEditor.revisionNotePlaceholder")} />
        </label>
      </section>
      <div class="form-actions">
        <button type="submit">{t("archiveEditor.saveArchive")}</button>
        <a href="/ap-admin/archives" class="secondary-button">{t("archiveEditor.cancel")}</a>
      </div>
    </form>
  </AdminLayout>
) : (
  <AdminLayout
    title={isForbidden ? t("archiveEditor.forbiddenTitle") : t("archiveEditor.notFoundTitle")}
    heading={isForbidden ? t("archiveEditor.forbiddenTitle") : t("archiveEditor.notFoundTitle")}
    currentPath="/ap-admin/archives"
    description={isForbidden ? t("archiveEditor.forbiddenDesc") : t("archiveEditor.notFoundDesc")}
    userName={safeAdminUserName(adminUser)}
  >
    <section class="panel">
      <p>{isForbidden ? t("archiveEditor.forbiddenBody") : t("archiveEditor.notFoundDesc")}</p>
    </section>
  </AdminLayout>
)}

<style>
  .archive-form {
    display: grid;
    gap: 1rem;
  }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  label {
    display: grid;
    gap: 0.45rem;
    margin-bottom: 1rem;
  }
  label span {
    font-weight: 600;
  }
  input,
  textarea {
    font: inherit;
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    padding: 0.75rem 0.85rem;
    background: white;
  }
  .form-actions {
    display: flex;
    gap: 0.75rem;
  }
  button,
  .secondary-button {
    display: inline-flex;
    align-items: center;
    border: 0;
    border-radius: 0.75rem;
    padding: 0.85rem 1rem;
    background: var(--accent);
    color: white;
    font: inherit;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    width: fit-content;
  }
  .secondary-button {
    background: #67707b;
  }
  .toolbar a,
  .field-note a {
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }
  .toolbar a:hover,
  .field-note a:hover {
    text-decoration: underline;
  }
  .field-note {
    margin: 0 0 1rem 0;
    color: var(--muted);
  }
</style>
