---
// Public renderer for admin-authored structured pages — the PRERENDERED
// production entrypoint. Injected at `/[...slug]` by
// createAstropressPublicSiteIntegration for `astro build` (output: static) and
// `astro preview`, so a page composed in the admin (Pages ▸ section editor)
// renders at its public URL in the deployed static site.
//
// In `astro dev` the integration injects the on-demand sibling
// (astropress-public-page-dev.astro) instead — see #198 — so pages published
// while the dev server is running render immediately, without waiting for
// getStaticPaths to be re-enumerated on a server restart.
import { buildPublicStructuredPageModel, listPublishedStructuredPagePaths } from "astropress";
import AstropressPublicPageDocument from "../components/AstropressPublicPageDocument.astro";

export const prerender = true;

export async function getStaticPaths() {
	// Only published pages are public; drafts/review/archived and the host-owned
	// root are excluded by listPublishedStructuredPagePaths.
	const paths = await listPublishedStructuredPagePaths();
	return paths.map((path) => ({ params: { slug: path.replace(/^\//, "") } }));
}

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join("/") : (slugParam ?? "");
const model = await buildPublicStructuredPageModel(`/${slug}`, Astro.locals);
// Guard the prerender/SSR path too: only published pages are public.
if (!model) {
	return new Response("Not found", { status: 404 });
}
---

<AstropressPublicPageDocument model={model} />
